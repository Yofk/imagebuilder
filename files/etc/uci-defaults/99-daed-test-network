#!/bin/sh

# Network configuration is baked in verbatim via files/etc/config/network:
#   - loopback, globals (packet steering / DUID) — harmless, kept as-is
#   - LAN: br-lan (eth0), static 10.0.0.1/24
#   - WAN: eth1, static 192.168.1.100/24, gw 192.168.1.1
#   - WAN6: eth1, DHCPv6

uci set dropbear.main.enable='1'
uci set dropbear.main.PasswordAuth='on'
uci set dropbear.main.RootPasswordAuth='on'
uci set dropbear.main.Port='22'
uci set dropbear.main.Interface='lan'
uci commit dropbear

# Default root password: password2r
printf 'password2r\npassword2r\n' | passwd root

/etc/init.d/dropbear restart

exit 0
